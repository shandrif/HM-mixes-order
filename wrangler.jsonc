{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hm-mixes-order",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  // The web app (built by Vite into ./dist) is served as static assets;
  // /api/* goes to the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hm-mixes-db",
      // Paste the Database ID from Cloudflare → Storage & Databases → D1 → hm-mixes-db
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Every 15 minutes: lock days past their cutoff (18:30 Riyadh by default),
  // copy forward missing stores, run anomaly checks, open the next day.
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
